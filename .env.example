# ============================================================================
# Chamados — variáveis de ambiente (dev)
# Copie para `.env` na raiz: cp .env.example .env
# Os defaults abaixo já batem com o docker-compose.yml; em dev normalmente
# não é preciso alterar nada. O código também tem estes mesmos defaults, então
# a aplicação sobe mesmo sem .env.
# ============================================================================

# ---------- PostgreSQL ----------
# Usuário administrador do container (superuser). RODA AS MIGRATIONS.
# Tem BYPASSRLS — NUNCA é usado nas conexões da aplicação.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chamados
POSTGRES_USER=chamados
POSTGRES_PASSWORD=chamados

# Role da APLICAÇÃO (web + worker). Criada pela primeira migration.
# SEM BYPASSRLS: toda query passa pela Row-Level Security.
# A senha aqui DEVE ser igual à usada na migration que cria o role.
APP_DB_USER=chamados_app
APP_DB_PASSWORD=chamados_app

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- MinIO (storage S3-compat) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Host do MinIO (default: mesmo host do Postgres). Bucket único, prefixo/tenant.
MINIO_HOST=localhost
STORAGE_BUCKET=chamados
# Sobrescreva o endpoint completo se necessário (default http://$MINIO_HOST:$MINIO_PORT).
# STORAGE_ENDPOINT=http://localhost:9000

# ---------- Web ----------
# Porta do Next dev server.
WEB_PORT=3000

# ---------- Cofre de segredos (SecretStore, specs/07 §5.2, specs/09 §7) ----------
# Chave MESTRA do envelope encryption (AES-256-GCM). 32 bytes em base64.
# FICA FORA DO BANCO. Gere uma por ambiente e NUNCA versione um valor real:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_STORE_MASTER_KEY=

# ---------- Auth ----------
# Credencial de serviço do agente_ia (autenticação máquina-a-máquina, specs/03
# §6). No provisionamento (M2) este token é MIGRADO para o cofre de segredos e
# `usuario.credencial_servico_ref` passa a apontar para o id do segredo. Deixe
# vazio para não cadastrar credencial. NUNCA versionar um valor real.
AGENTE_IA_TOKEN=

# ---------- Agente de IA / triagem (worker — specs/05, specs/01 §4) ----------
# Provider da abstração AIProvider: 'fake' (determinístico, dev/teste, SEM rede
# nem custo — DEFAULT) ou 'claude' (Claude Agent SDK, Opus 4.8).
IA_PROVIDER=fake
# Autenticação do provider 'claude' (D-012): defina UMA das duas variáveis abaixo
# (necessário só quando IA_PROVIDER=claude). Precedência: ANTHROPIC_API_KEY vence o
# token de assinatura na cadeia do CLI. NUNCA versionar valores reais.
# Chave da API Anthropic — recomendada para produção/multi-tenant.
ANTHROPIC_API_KEY=
# Token de ASSINATURA (mesma conta do Claude Code). Gere numa máquina COM navegador:
#   claude setup-token
# e copie o token gerado para cá. Vale ~1 ano e NÃO renova sozinho (troque antes de
# expirar). Por ser env var, funciona em serviço headless, independente da conta
# Windows logada. AVISO: a documentação oficial do Agent SDK direciona produtos a
# usar ANTHROPIC_API_KEY; o token de assinatura é documentado para CI/scripts
# próprios — use por sua conta para instalação própria (ver specs/decisoes.md D-012).
# CLAUDE_CODE_OAUTH_TOKEN=
# Modelo do provider real (Opus 4.8). Ignorado pelo provider 'fake'.
IA_MODELO=claude-opus-4-8
# Limites por execução (o provider honra: timeout via abort; budget/turnos → corte).
# Timeout excedido → ExecucaoIA.falhou com erro='timeout'; budget → erro='budget_excedido'.
IA_TIMEOUT_MS=600000
IA_BUDGET_USD=5
IA_MAX_TURNOS=20

# Mapa de conhecimento do sistema (D-013): execução dedicada que explora o repo e
# persiste um resumo (stack, módulos, regras de negócio) injetado em toda triagem.
# Re-gerado quando o commit muda ou via "Mapear agora" no cadastro do sistema.
IA_MAPA_BUDGET_USD=10
IA_MAPA_MAX_TURNOS=40
IA_MAPA_MAX_CHARS=12000
IA_MAPA_TIMEOUT_MS=600000
# Debounce (segundos) antes de processar a triagem: agrupa mensagens em rajada e
# permite que uma nova mensagem SUBSTITUA a triagem pendente do chamado (specs/05 §2).
TRIAGEM_DEBOUNCE_S=45
# (Opcional) Concorrência global da fila triagem-ia e lock por tenant.
# TRIAGEM_CONCURRENCY=2
# TRIAGEM_LOCK_TTL_MS=900000

# ---------- Ferramentas read-only da triagem (M7 — specs/05 §3.2/§4.2) ----------
# Repositório do SistemaAlvo em DIRETÓRIO LOCAL do servidor (D-011). Quando 'true',
# o git_repo_url aceita caminho absoluto (ex.: C:\repos\meu-sistema, /srv/repos/erp)
# ou file:// além de git remoto; nesse caso a credencial git é dispensável. Default
# 'false': a oferta SaaS mantém desligada (um admin de tenant não pode apontar para
# qualquer repo do host). Instalações self-hosted ligam. Em produção com Docker,
# monte o diretório como volume no container do worker.
# SISTEMAS_PERMITIR_REPO_LOCAL=false
# Base do CACHE de working copies do worker (git clone/pull por tenant+sistema).
# Default: <tmp>/chamados-repos. É o "diretório de trabalho" do agente (specs/05 §3.2).
# IA_REPO_CACHE_DIR=/var/lib/chamados/repos
# Limites do repo (tamanho de arquivo lido, resultados de busca, arquivos varridos).
# IA_REPO_MAX_ARQUIVO_BYTES=524288
# IA_REPO_MAX_RESULTADOS=100
# IA_REPO_MAX_ARQUIVOS=5000
# Limites de logs (tail): linhas devolvidas, bytes lidos, arquivos por glob.
# IA_LOGS_MAX_LINHAS=200
# IA_LOGS_MAX_BYTES=2097152
# IA_LOGS_MAX_ARQUIVOS=20
# BD read-only do sistema-alvo: statement_timeout (ms), LIMIT forçado, timeout de conexão.
# IA_BD_TIMEOUT_MS=5000
# IA_BD_MAX_LINHAS=100
# IA_BD_CONEXAO_TIMEOUT_MS=5000

# ---------- Resolução automática via PR (M8 — specs/05 §6) ----------
# Gate da tentativa de resolução: SÓ quando natureza=problema + complexidade=facil
# + compreendido com confiança >= este limiar + tenant.ia_resolucao_automatica_habilitada.
# O gate fica no PIPELINE (worker), nunca no provider. Default da spec 05 §5.1: 0.7.
# IA_RESOLUCAO_CONFIANCA_MIN=0.7
# Limites das ferramentas de ESCRITA (working copy descartável): nº de arquivos,
# bytes por arquivo e bytes totais que a tentativa pode alterar (correção pontual).
# IA_RESOLUCAO_MAX_ARQUIVOS=10
# IA_RESOLUCAO_MAX_ARQUIVO_BYTES=262144
# IA_RESOLUCAO_MAX_BYTES_TOTAL=1048576
# Timeout do POST de abertura de PR no GitHub (ms).
# IA_RESOLUCAO_PR_TIMEOUT_MS=10000
# Base URL do painel para montar o link do chamado no corpo do PR (ex.:
# https://acme.chamados.app). Vazio → o PR referencia só o número do chamado.
# APP_BASE_URL=

# ---------- Notificações (M9 — worker + web, specs/06) ----------
# SMTP da PLATAFORMA por onde o worker entrega os e-mails (dev: Mailpit do
# docker-compose). Em produção, aponte para SES/Resend/Postmark/SMTP próprio.
NOTIFICACOES_SMTP_HOST=localhost
NOTIFICACOES_SMTP_PORT=1025
NOTIFICACOES_SMTP_SECURE=false
# Credenciais SMTP (Mailpit aceita qualquer uma; deixe vazio em dev).
# NOTIFICACOES_SMTP_USER=
# NOTIFICACOES_SMTP_PASS=
# Remetente default da plataforma (usado quando o tenant não define o seu no
# branding). O display name real do tenant entra no "From" em runtime.
NOTIFICACOES_REMETENTE_NOME=Chamados
NOTIFICACOES_REMETENTE_EMAIL=nao-responda@chamados.local
# Webhook: timeout por requisição (ms) e nº de falhas consecutivas até desativar
# o canal automaticamente e alertar os admins (specs/06 §3.2).
NOTIFICACOES_WEBHOOK_TIMEOUT_MS=5000
NOTIFICACOES_WEBHOOK_MAX_FALHAS=10
# Host base da plataforma para montar os deep links dos e-mails (dev: subdomínio
# do tenant em .localhost). Tenants com domínio próprio usam o próprio host.
NOTIFICACOES_HOST_PLATAFORMA=localhost:3000
# (Opcional) Concorrência da fila de notificações (entrega é barata).
# NOTIFICACOES_CONCURRENCY=5

# ---------- Mailpit (SMTP + inbox de DEV, docker-compose) ----------
# Porta SMTP (recebe os e-mails do worker) e porta da UI (inbox em http://localhost:8025).
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- Manutenção / auto-fechamento (M10 — worker, specs/04 §8.1) ----------
# Intervalo (ms) entre varreduras que auto-fecham chamados `resolvido` cujo prazo
# (fechar_automaticamente_em) venceu. Default: 5 min. O prazo em DIAS é por tenant
# (tenant.dias_fechamento_automatico); este intervalo é só a cadência do job.
# MANUTENCAO_INTERVALO_MS=300000
# TTL (ms) do lock global da varredura (evita instâncias concorrentes duplicarem
# o trabalho). Deve ser menor que o intervalo e maior que uma varredura típica.
# MANUTENCAO_LOCK_TTL_MS=240000

# ---------- Segurança / hardening (M10 frente B — specs/09, specs/03) ----------
# Rate limiting (Redis) dos fluxos de credencial. Limites FOLGADOS por padrão: um
# uso humano normal nunca os atinge; protegem contra brute-force/enumeração. Se o
# Redis estiver fora, o rate limiting FALHA ABERTO (nunca bloqueia login legítimo).
# Master switch: defina como "false" para desligar (ex.: testes de carga).
# RATE_LIMIT_HABILITADO=true
# Login: máx por e-mail e por IP dentro da janela (segundos).
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_IP_MAX=30
# RATE_LIMIT_LOGIN_JANELA_S=300
# Esqueci-senha: máx por e-mail e por IP dentro da janela (anti e-mail bombing).
# RATE_LIMIT_RESET_MAX=5
# RATE_LIMIT_RESET_IP_MAX=20
# RATE_LIMIT_RESET_JANELA_S=900
# Fluxos por token (redefinir senha / aceitar convite): máx por IP e janela.
# RATE_LIMIT_TOKEN_IP_MAX=20
# RATE_LIMIT_TOKEN_JANELA_S=900

# Webhook de notificações — proteção anti-SSRF (specs/09 §5). Por padrão, hosts
# privados/loopback/link-local/metadata (localhost, 127.0.0.0/8, 10/8, 172.16/12,
# 192.168/16, 169.254/16, ::1, ...) são BLOQUEADOS ao salvar e ao enviar. Em DEV,
# defina "true" para testar contra um receptor local (ex.: http://localhost:4000).
# NOTIFICACOES_WEBHOOK_PERMITIR_PRIVADO=false
