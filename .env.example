# ============================================================================
# Chamados — variáveis de ambiente (dev)
# Copie para `.env` na raiz: cp .env.example .env
# Os defaults abaixo já batem com o docker-compose.yml; em dev normalmente
# não é preciso alterar nada. O código também tem estes mesmos defaults, então
# a aplicação sobe mesmo sem .env.
# ============================================================================

# ---------- PostgreSQL ----------
# Usuário administrador do container (superuser). RODA AS MIGRATIONS.
# Tem BYPASSRLS — NUNCA é usado nas conexões da aplicação.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chamados
POSTGRES_USER=chamados
POSTGRES_PASSWORD=chamados

# Role da APLICAÇÃO (web + worker). Criada pela primeira migration.
# SEM BYPASSRLS: toda query passa pela Row-Level Security.
# A senha aqui DEVE ser igual à usada na migration que cria o role.
APP_DB_USER=chamados_app
APP_DB_PASSWORD=chamados_app

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- MinIO (storage S3-compat) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Host do MinIO (default: mesmo host do Postgres). Bucket único, prefixo/tenant.
MINIO_HOST=localhost
STORAGE_BUCKET=chamados
# Sobrescreva o endpoint completo se necessário (default http://$MINIO_HOST:$MINIO_PORT).
# STORAGE_ENDPOINT=http://localhost:9000

# ---------- Web ----------
# Porta do Next dev server.
WEB_PORT=3000

# ---------- Cofre de segredos (SecretStore, specs/07 §5.2, specs/09 §7) ----------
# Chave MESTRA do envelope encryption (AES-256-GCM). 32 bytes em base64.
# FICA FORA DO BANCO. Gere uma por ambiente e NUNCA versione um valor real:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_STORE_MASTER_KEY=

# ---------- Auth ----------
# Credencial de serviço do agente_ia (autenticação máquina-a-máquina, specs/03
# §6). No provisionamento (M2) este token é MIGRADO para o cofre de segredos e
# `usuario.credencial_servico_ref` passa a apontar para o id do segredo. Deixe
# vazio para não cadastrar credencial. NUNCA versionar um valor real.
AGENTE_IA_TOKEN=
