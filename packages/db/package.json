{
  "name": "@chamados/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migration:run": "tsx src/scripts/migrate.ts",
    "migration:revert": "tsx src/scripts/migrate.ts --revert",
    "smoke:rls": "tsx src/scripts/smoke-rls.ts",
    "smoke:auth": "tsx src/scripts/smoke-auth.ts",
    "smoke:secrets": "tsx src/scripts/smoke-secrets.ts",
    "smoke:sistemas": "tsx src/scripts/smoke-sistemas.ts",
    "smoke:chamados": "tsx src/scripts/smoke-chamados.ts",
    "smoke:mensagens": "tsx src/scripts/smoke-mensagens.ts",
    "smoke:seguranca": "tsx src/scripts/smoke-seguranca.ts",
    "seed:dev": "tsx src/scripts/seed-dev.ts"
  },
  "dependencies": {
    "@chamados/shared": "*",
    "@chamados/storage": "*",
    "@node-rs/argon2": "^2.0.2",
    "bullmq": "^5.34.5",
    "ioredis": "^5.4.2",
    "marked": "^18.0.6",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
