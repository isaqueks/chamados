{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@comum/*": ["../comum/*"]
    }
  },
  "include": ["src/**/*", "../comum/**/*.ts"],
  "exclude": ["../comum/**/*.test.ts"]
}
