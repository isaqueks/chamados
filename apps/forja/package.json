{
  "name": "@chamados/forja",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Forja: client local que implementa chamados do Chamados com a CLI do Claude Code (specs/forja)",
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"FORJA_MODO=dev tsx watch server/main.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "smoke:cli": "tsx server/scripts/smoke-cli.ts",
    "smoke:local": "tsx server/scripts/smoke-local.ts",
    "migration:run": "tsx server/scripts/migrar.ts run",
    "migration:revert": "tsx server/scripts/migrar.ts revert",
    "spike:s1": "tsx server/scripts/spikes/spike.ts s1",
    "spike:s2": "tsx server/scripts/spikes/spike.ts s2",
    "spike:s3": "tsx server/scripts/spikes/spike.ts s3",
    "spike:s4": "tsx server/scripts/spikes/spike.ts s4",
    "spike:s5": "tsx server/scripts/spikes/spike.ts s5",
    "spike:s6": "tsx server/scripts/spikes/spike.ts s6",
    "spike:s7": "tsx server/scripts/spikes/spike.ts s7",
    "spike:s8": "tsx server/scripts/spikes/spike.ts s8",
    "spike:s9": "tsx server/scripts/spikes/spike.ts s9",
    "spike:s10": "tsx server/scripts/spikes/spike.ts s10"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@chamados/cliente-api": "*",
    "@chamados/shared": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@napi-rs/keyring": "^2.1.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@tanstack/react-query": "^5.90.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.6.0",
    "lucide-react": "^1.24.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.56.0",
    "react": "19.2.4",
    "react-diff-view": "^3.3.2",
    "react-dom": "19.2.4",
    "react-router": "^7.9.0",
    "reflect-metadata": "^0.2.2",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "typeorm": "^0.3.20",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.1.0"
  }
}
